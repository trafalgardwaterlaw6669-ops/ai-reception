{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient CRM record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "birthDate": { "type": "string" },
        "medicalNotes": { "type": "string" },
        "preferredLanguage": { "type": "string", "enum": ["Darija", "French", "Arabic", "English"] },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName", "lastName", "phone"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled clinic appointments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "clinicId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientName", "date", "time"]
    }
  },
  "firestore": {
    "patients": {
      "schema": "Patient",
      "description": "User patient collection in the database"
    },
    "appointments": {
      "schema": "Appointment",
      "description": "Appointments collection in the database"
    }
  }
}
